---
import { getCollection } from "astro:content";
import BrandLayout from "../layouts/BrandLayout.astro";
import Screenshot from "../components/Screenshot.astro";

const [screenshots] = await getCollection("screenshots");
const items = screenshots.data.items;
---

<BrandLayout
  slug="application"
  eyebrow="Brand Elements"
  title="App Screenshots"
  subtitle="How the AVA Golf brand comes to life on screen, straight from the product."
>
  <div class="mx-auto max-w-6xl space-y-20">
    {items.map((item, i) => <Screenshot item={item} divider={i > 0} />)}
  </div>
</BrandLayout>
