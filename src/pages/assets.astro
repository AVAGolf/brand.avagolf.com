---
import { getCollection } from "astro:content";
import BrandLayout from "../layouts/BrandLayout.astro";
import Asset from "../components/Asset.astro";

const [assets] = await getCollection("assets");
const items = assets.data.items;
---

<BrandLayout
  slug="assets"
  eyebrow="Brand Elements"
  title="Assets"
  subtitle="Part of our brand identity is made up of brand elements, this include textures, graphics and icons."
>
  <div class="mx-auto max-w-6xl space-y-20">
    {items.map((item, i) => <Asset item={item} divider={i > 0} />)}
  </div>
</BrandLayout>
