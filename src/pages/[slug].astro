---
import { getCollection, render } from "astro:content";
import BrandLayout from "../layouts/BrandLayout.astro";

export async function getStaticPaths() {
  const guides = await getCollection("guides");
  return guides.map((guide) => ({ params: { slug: guide.id }, props: { guide } }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
const adrBase = "https://github.com/AVAGolf/app.avagolf.com/blob/stage/docs/decisions/";
---

<BrandLayout
  slug={guide.id}
  eyebrow={guide.data.eyebrow}
  title={guide.data.title}
  subtitle={guide.data.subtitle}
>
  <div class="guide mx-auto max-w-6xl space-y-12">
    <Content />
    {
      guide.data.adrs.length > 0 && (
        <section class="border-t border-green-500/30 pt-12">
          <h2 class="text-h2 text-dark-green-900 mb-4">Decisions</h2>
          <ul class="text-body text-dark-green-700 space-y-2">
            {guide.data.adrs.map((adr) => (
              <li>
                <a class="underline" href={`${adrBase}${adr}`}>
                  {adr.replace(/\.md$/, "")}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BrandLayout>

<style is:global>
  @reference "../styles/global.css";

  .guide h2 {
    @apply text-h2 text-dark-green-900 mb-4 mt-12 first:mt-0;
  }
  .guide h3 {
    @apply text-body-strong text-green-900 mb-2 mt-8;
  }
  .guide p,
  .guide li {
    @apply text-body text-dark-green-700 max-w-3xl;
  }
  .guide ul {
    @apply list-disc space-y-2 pl-6;
  }
  .guide ol {
    @apply list-decimal space-y-2 pl-6;
  }
  .guide table {
    @apply text-body text-dark-green-700 my-6 w-full border-collapse;
  }
  .guide th,
  .guide td {
    @apply border-b border-green-500/30 py-2 pr-4 text-left align-top;
  }
  .guide code {
    @apply text-code text-dark-green-900 rounded bg-white/70 px-1;
  }
  .guide a {
    @apply underline;
  }
</style>
