---
import BrandLayout from "../layouts/BrandLayout.astro";
import { brandPack, packSummary, PACK_PATH } from "../lib/brandPack";

// Version, date and size from the manifest the brand-pack workflow publishes
// (src/lib/brandPack.ts). The zip keeps one URL; `download` saves it under the
// version's own name, e.g. AVA_Golf_Brand_Pack_v1.0.3.zip. The build writes the
// numbers into the page; the script below re-reads the manifest in the browser,
// so a pack published since the last build shows its own number at once.
const pack = await brandPack();
---

<BrandLayout
  slug=""
  eyebrow="AVA Golf"
  title="Brand Guidelines"
  subtitle="Guidelines on how to implement and use the AVA Golf brand."
  variant="hero"
>
  <div slot="hero-cta" class="mt-10 flex flex-col items-center gap-4">
    <a
      href={PACK_PATH}
      download={pack.filename}
      data-pack-download
      class="text-button hover:bg-yellow-300 hover:text-dark-green-900 inline-flex h-12 w-80 items-center justify-center rounded-full border-2 border-yellow-300 text-white transition-colors"
      style="letter-spacing:0.1em;"
    >
      Download Brand Pack
    </a>
    <p class="text-micro text-bright-green-500" data-pack-summary data-version={pack.version}>{packSummary(pack)}</p>
  </div>

  <div class="max-w-[750px]">
    <p class="text-label text-green-700 mb-6 uppercase tracking-widest">
      Introduction
    </p>
    <div class="text-body text-dark-green-700 space-y-5">
      <p>
        Our brand is built on consistency — not as a constraint, but as a mark of confidence.
These guidelines establish how the AVA Golf brand is expressed across every context:
the visual language, tone of voice, and communication principles that make every
interaction recognizable, intentional, and true to who we are.
      </p>
      <p>
        Within these pages you'll find everything needed to represent AVA Golf with precision, 
from visual elements and logo usage through to voice, values, and audience. Used
well, these guidelines ensure every touchpoint reflects a brand built for serious golfers
and the people who share their ambition.
      </p>
    </div>
  </div>
</BrandLayout>

<script>
  // The brand pack can be republished between site builds (the brand-pack
  // workflow in AVA-Golf-Brand-Assets writes /files/brand-pack.json next to
  // the zip). Read it once the page is idle and, if it names a newer pack than
  // the build did, show that one. Same origin, no-cache (S3's ETag makes it a
  // 304 when nothing changed), and silent on any failure: the built-in numbers
  // stay.
  import { parseManifest, packSummary } from "../lib/brandPack";

  const refresh = () =>
    fetch("/files/brand-pack.json", { cache: "no-cache" })
      .then((res) => (res.ok ? res.json() : null))
      .then((data) => {
        if (!data) return;
        const pack = parseManifest(data);
        const summary = document.querySelector<HTMLElement>("[data-pack-summary]");
        if (summary && summary.dataset.version !== pack.version) {
          summary.textContent = packSummary(pack);
          summary.dataset.version = pack.version;
        }
        document.querySelector("[data-pack-download]")?.setAttribute("download", pack.filename);
      })
      .catch(() => {});

  const idle = () => ("requestIdleCallback" in window ? requestIdleCallback(refresh) : setTimeout(refresh, 200));
  if (document.readyState === "complete") idle();
  else window.addEventListener("load", idle, { once: true });
</script>
