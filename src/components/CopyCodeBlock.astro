---
import { Code } from "astro:components";

interface Props {
  code: string;
  displayCode?: string;
  label: string;
  downloadHref?: string;
}

const { code, displayCode = code, label, downloadHref } = Astro.props;

// Several of these blocks can share a page, so name the file in the
// accessible label to keep the "Download" links distinguishable.
const downloadFile = downloadHref?.split("/").pop();
---

<div>
  <p class="text-label text-dark-green-700 mb-3 font-bold uppercase tracking-widest">
    {label}
    {
      downloadHref && (
        <>
          <span class="text-green-500/50 mx-2" aria-hidden="true">
            |
          </span>
          <a
            href={downloadHref}
            download
            aria-label={`Download ${downloadFile}`}
            class="text-green-700 hover:text-green-900 underline underline-offset-4 transition-colors"
          >
            Download
          </a>
        </>
      )
    }
  </p>
  <div class="relative overflow-hidden rounded-lg">
    <button
      type="button"
      data-copy-button
      data-copy-text={code}
      class="text-code bg-dark-green-700 text-white hover:bg-dark-green-500 absolute top-3 right-3 z-10 rounded-md px-3 py-1.5 transition-colors"
    >
      Copy
    </button>
    <Code
      code={displayCode}
      lang="html"
      theme="github-dark"
      class="text-code overflow-x-auto p-6 pr-24!"
    />
  </div>
</div>

<script>
  document.addEventListener("click", async (e) => {
    const button = (e.target as HTMLElement).closest<HTMLButtonElement>(
      "[data-copy-button]",
    );
    if (!button) return;

    const text = button.dataset.copyText ?? "";
    await navigator.clipboard.writeText(text);

    const original = button.textContent;
    button.textContent = "Copied!";
    setTimeout(() => {
      button.textContent = original;
    }, 1500);
  });
</script>
