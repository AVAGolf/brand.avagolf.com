---
// The guideline pages, as a fixed left column from the `sidebar` breakpoint
// (901px, where avagolf.com's shared bar switches from its MENU button to its
// desktop links) up. Below that the same list is in the shared mobile menu
// (BrandMenu), so a phone has one menu, not two.
//
// The shared bar is fixed across the top of the page and floats the AVA logo
// over the column's top-left corner, so the column starts its content 88px
// down and carries no logo of its own (global.css keeps the floating logo
// visible over the column after the header scrolls away).
import { groupOrder, sectionHref, sectionsByGroup } from "../lib/sections";

interface Props {
  activeSlug?: string;
}

const { activeSlug } = Astro.props;
const groups = sectionsByGroup();
---

<aside
  class="bg-dark-green-500 shadow-sidebar fixed inset-y-0 left-0 z-40 hidden w-[260px] flex-col pt-[88px] sidebar:flex"
>
  <p class="text-micro text-green-300 border-dark-green-300 border-b px-12 pb-6 uppercase tracking-widest">
    Brand Guidelines
  </p>

  <nav class="scrollbar-hide flex-1 overflow-y-auto py-8" aria-label="Brand guidelines">
    {
      groupOrder.map((group) => (
        <div class="mb-8 last:mb-0">
          <p class="text-label text-white mb-4 px-12 font-bold uppercase tracking-widest">
            {group}
          </p>
          <ul>
            {groups[group].map((s) => {
              const isActive = s.slug === activeSlug;
              return (
                <li>
                  <a
                    href={sectionHref(s)}
                    aria-current={isActive ? "page" : undefined}
                    class:list={[
                      "text-nav relative flex h-9 items-center px-12 font-normal uppercase tracking-widest transition-colors",
                      isActive
                        ? "bg-dark-green-900 text-bright-green-500"
                        : "text-grey-300 hover:bg-dark-green-700 hover:text-white",
                    ]}
                  >
                    <span>{s.title}</span>
                    {isActive && (
                      <span
                        aria-hidden="true"
                        class="text-bright-green-500 absolute right-3 text-xl leading-none"
                      >
                        ◄
                      </span>
                    )}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }
  </nav>
</aside>
