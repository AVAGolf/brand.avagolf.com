---
import Footer from "@shared/Footer.astro";
import Layout from "./Layout.astro";
import BrandSidebar from "../components/BrandSidebar.astro";
import BrandHeader from "../components/BrandHeader.astro";
import BrandPagination from "../components/BrandPagination.astro";
import { getAdjacent, markdownHref } from "../lib/sections";
import { heroImage } from "../lib/heroImage";
import { breadcrumbs } from "../lib/schema";

interface Props {
  slug: string;
  eyebrow: string;
  title: string;
  subtitle?: string;
  variant?: "default" | "hero";
  noindex?: boolean;
}

const { slug, eyebrow, title, subtitle, variant, noindex } = Astro.props;
const { current } = getAdjacent(slug);
const pageTitle = current ? `${current.title} — AVA Golf Brand Guide` : title;
const hero = await heroImage();
// Brand Guidelines › Colors, for every page but the first.
const schema = current?.slug
  ? [breadcrumbs([{ name: "Brand Guidelines", href: "/" }, { name: current.title }])]
  : [];
---

<Layout
  title={pageTitle}
  description={subtitle}
  activeSlug={slug}
  preloadImage={hero}
  schema={schema}
  noindex={noindex}
  markdown={current ? markdownHref(current) : undefined}
>
  <BrandSidebar activeSlug={slug} />

  <div class="flex min-h-screen flex-col sidebar:ml-[260px]">
    <BrandHeader
      eyebrow={eyebrow}
      title={title}
      subtitle={subtitle}
      variant={variant}
      image={hero}
    >
      <slot name="hero-cta" slot="cta" />
    </BrandHeader>

    <main class="bg-grey-300 flex-1 px-6 py-10 lg:px-12 lg:py-16">
      <slot />
    </main>

    <div class="bg-grey-300">
      <BrandPagination slug={slug} />
    </div>

    <Footer site="brand" />
  </div>
</Layout>
