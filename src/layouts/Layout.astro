---
// The document every page renders through: <head>, consent, the site's GA4
// tag, and avagolf.com's shared top bar.
//
// The chrome is avagolf.com's: <Nav>, <MobileMenuFooter> and <Footer> come
// from shared-components/, which the build takes from avagolf.com's main (see
// scripts/take-shared-components.sh). Change a link there and this site picks
// it up on its next build. What the shared chrome leaves to the site that
// renders it lives in src/components/site/ and src/lib/, copied from
// news.avagolf.com: consent, the mobile-menu focus fix, meta tags, JSON-LD and
// the app-link attribution. The footer is placed by the page layouts
// (BrandLayout, tokens), because on guideline pages it sits beside the sidebar.
import Nav from "@shared/Nav.astro";
import MobileMenuFooter from "@shared/MobileMenuFooter.astro";
import sansFlexUrl from "@shared/fonts/GoogleSansFlex.woff2?url";
import CookieConsent from "@/components/site/CookieConsent.astro";
import Head from "@/components/site/Head.astro";
import MenuInert from "@/components/site/MenuInert.astro";
import BrandMenu from "@/components/BrandMenu.astro";
import { brandPack } from "@/lib/brandPack";
import { graph, SITE, type Node } from "@/lib/schema";
import "@shared/styles/tokens.css";
import "@shared/styles/fonts.css";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** The guideline page being shown, marked current in the mobile menu. */
  activeSlug?: string;
  /** The LCP image, preloaded at high priority with its <img>'s srcset. */
  preloadImage?: { srcset: string; sizes: string };
  /** Page-specific JSON-LD nodes (breadcrumbs), added to the site graph. */
  schema?: Node[];
  /** Keep the page out of search (the 404 page). */
  noindex?: boolean;
}

const {
  title = "AVA Golf — Brand Guidelines",
  description = "Brand identity, design tokens, and guidelines for AVA Golf — logo marks, color palette, typography, and application principles.",
  activeSlug,
  preloadImage,
  schema = [],
  noindex = false,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, SITE).href;
const pack = await brandPack();
const socialImage = {
  url: `${SITE}/og-image.jpg`,
  width: 1200,
  height: 630,
  type: "image/jpeg",
  alt: "AVA Golf — Brand Guidelines",
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Consent Mode defaults. Inline, and first after the meta tags: they must
        be in the dataLayer before the edge's GTM container or the gtag.js
        below runs anything. */}
    <CookieConsent />

    {/* brand.avagolf.com's own GA4 property, as it has always been set up.
        The snippet is Google's, unchanged; `is:inline` keeps it a plain
        script, as Google ships it, instead of a bundled module. */}
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-X34R7TJNMF"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-X34R7TJNMF');
    </script>

    {/* The LCP image first, then the one face above the fold. The preload
        carries the <img>'s srcset and sizes and no href, so the browser
        fetches exactly the candidate the <img> will use, once. */}
    {
      preloadImage && (
        <link
          rel="preload"
          as="image"
          imagesrcset={preloadImage.srcset}
          imagesizes={preloadImage.sizes}
          fetchpriority="high"
        />
      )
    }
    <link rel="preload" href={sansFlexUrl} as="font" type="font/woff2" crossorigin />

    <Head
      siteName="AVA Golf — Brand Guidelines"
      title={title}
      description={description}
      canonical={canonicalUrl}
      author="AVA Golf"
      noindex={noindex}
      image={socialImage}
    />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />

    <slot name="head" />

    <script type="application/ld+json" is:inline set:html={graph(pack, schema)} />
  </head>
  <body>
    <Nav site="brand">
      <BrandMenu activeSlug={activeSlug} />
      <MobileMenuFooter site="brand" />
    </Nav>
    <slot />
    <MenuInert />

    <script>
      import { decorateAppLinks } from "@/lib/appLinks";

      // app.avagolf.com links (the shared bar's Log In and Start Free) carry
      // the visit's campaign and click IDs, as on avagolf.com and news.
      try {
        decorateAppLinks();
      } catch {
        // Attribution is a nice-to-have; a broken link never is.
      }
    </script>
  </body>
</html>
